{
  manifest_version: "0.1.0",

  // Required so we can mount the host Docker socket — needed by the
  // SWE-bench handler, which pulls the green agent's proprietary repo
  // image and exec's into it to read files and apply edits.
  experimental_features: ["docker"],

  config_schema: {
    type: "object",
    properties: {
      // OpenAI-compatible inference endpoint (default: OpenRouter).
      openrouter_api_key: { type: "string", secret: true },
      openrouter_base_url: { type: "string" },
      model_name: { type: "string" },

      // Optional web-search tool (Tavily).
      tavily_api_key: { type: "string", secret: true },

      // Master switch for our own tool surface (web_search, web_fetch,
      // shell_exec, read_file, write_file). Turn OFF for benchmarks
      // whose green agent already injects task-specific tools into the
      // system prompt as inline text (e.g. tau2-bench).
      tools_enabled: { type: "boolean" },
    },
    required: ["openrouter_api_key"],
    additionalProperties: false,
  },

  slots: {
    docker: { kind: "docker", optional: true },
  },

  program: {
    image: "ghcr.io/soumya-batra/agentswe-general:latest",
    entrypoint: "uv run python src/server.py --host 0.0.0.0 --port 9010",

    env: {
      OPENROUTER_API_KEY: "${config.openrouter_api_key}",
      OPENROUTER_BASE_URL: "${config.openrouter_base_url}",
      MODEL_NAME: "${config.model_name}",
      TAVILY_API_KEY: "${config.tavily_api_key}",
      TOOLS_ENABLED: "${config.tools_enabled}",
    },

    mounts: [
      { path: "/var/run/docker.sock", from: "framework.docker" },
    ],

    network: {
      endpoints: [
        { name: "a2a_endpoint", port: 9010 },
      ],
    },
  },

  provides: {
    a2a: { kind: "a2a", endpoint: "a2a_endpoint" },
  },

  exports: { a2a: "a2a" },
}
