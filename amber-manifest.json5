{
  manifest_version: "0.1.0",

  // Docker support is enabled via `slots.docker` + the framework.docker
  // mount below. Some amber-cli versions (e.g. v0 on tau2's leaderboard)
  // reject an `experimental_features` field, so we don't declare one.

  config_schema: {
    type: "object",
    properties: {
      // OpenAI-compatible inference endpoint (default: OpenRouter).
      openrouter_api_key: { type: "string", secret: true },
      openrouter_base_url: {
        type: "string",
        default: "https://openrouter.ai/api/v1",
      },
      model_name: { type: "string", default: "z-ai/glm-5" },

      // Optional web-search tool (Tavily). Empty string disables it.
      tavily_api_key: { type: "string", secret: true, default: "" },

      // Master switch for our own tool surface (web_search, web_fetch,
      // shell_exec, read_file, write_file). Turn OFF for benchmarks
      // whose green agent already injects task-specific tools into the
      // system prompt as inline text (e.g. tau2-bench).
      tools_enabled: { type: "boolean", default: false },

      // Force the LLM to emit a JSON object. Turn ON for benchmarks
      // whose green agent parses our response as JSON, e.g. tau2-bench
      // expects {"name": "<tool>", "arguments": {...}}. The green's
      // policy text must mention "JSON" or the API will 400.
      json_output: { type: "boolean", default: false },
    },
    required: ["openrouter_api_key"],
    additionalProperties: false,
  },

  slots: {
    docker: { kind: "docker", optional: true },
  },

  program: {
    image: "ghcr.io/soumya-batra/agentswe-general:latest",
    entrypoint: "uv run python src/server.py --host 0.0.0.0 --port 9010",

    env: {
      OPENROUTER_API_KEY: "${config.openrouter_api_key}",
      OPENROUTER_BASE_URL: "${config.openrouter_base_url}",
      MODEL_NAME: "${config.model_name}",
      TAVILY_API_KEY: "${config.tavily_api_key}",
      TOOLS_ENABLED: "${config.tools_enabled}",
      JSON_OUTPUT: "${config.json_output}",
    },

    mounts: [
      { path: "/var/run/docker.sock", from: "framework.docker" },
    ],

    network: {
      endpoints: [
        { name: "a2a_endpoint", port: 9010 },
      ],
    },
  },

  provides: {
    a2a: { kind: "a2a", endpoint: "a2a_endpoint" },
  },

  exports: { a2a: "a2a" },
}
